<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.recplatform</groupId>
        <artifactId>recplatform-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>recplatform-web</artifactId>
    <name>recplatform-web</name>
    <description>Web application entry point</description>

    <dependencies>
        <!-- Internal modules -->
        <dependency>
            <groupId>com.recplatform</groupId>
            <artifactId>recplatform-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.recplatform</groupId>
            <artifactId>recplatform-solver</artifactId>
        </dependency>
        <dependency>
            <groupId>com.recplatform</groupId>
            <artifactId>recplatform-data</artifactId>
        </dependency>
        <dependency>
            <groupId>com.recplatform</groupId>
            <artifactId>recplatform-orchestrator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.recplatform</groupId>
            <artifactId>recplatform-iam</artifactId>
        </dependency>
        <dependency>
            <groupId>com.recplatform</groupId>
            <artifactId>recplatform-audit</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- Web & API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <!-- Runtime -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.recplatform.web.RecPlatformApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
